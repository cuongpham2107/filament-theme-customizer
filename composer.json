{
    "name": "cuongpham/filament-theme-customizer",
    "description": "Instant zero-reload theme customizer plugin for Filament v5",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "filament",
        "plugin",
        "theme",
        "customizer"
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "filament/filament": "^5.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "CuongPham\\FilamentThemeCustomizer\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CuongPham\\FilamentThemeCustomizer\\ThemeCustomizerServiceProvider"
            ]
        }
    }
}
